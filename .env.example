# Supabase Configuration (Client - Anon Key an toàn cho trình duyệt)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Backend REST API Gateway (Port 5000 - giữ bí mật GEMINI_API_KEY phía Server)
VITE_API_BASE_URL=http://localhost:5000
# LƯU Ý BẢO MẬT: Tuyệt đối KHÔNG khai báo VITE_GEMINI_API_KEY ở đây.
# Hãy cấu hình GEMINI_API_KEY trong file server/.env!
